SERVER_PORT=9001
SERVER_SERVLET_CONTEXT_PATH=/api/v1
APP_NAME=Komflow

DB_HOST=localhost
DB_PORT=5432
DB_NAME=komflow_db
DB_USERNAME=komflow_user
DB_PASSWORD=change_me
DB_SCHEMA=komflow

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change_me@example.com
MAIL_PASSWORD=change_me

MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB
FILE_STORAGE_PATH=uploads

SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

JWT_SECRET=change_me
JWT_EXPIRATION_MS=43200000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_ISSUER=komflow-app
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_HTTPONLY=true
